# PILIH SALAH SATU DATABASE

# 1. SQLite (default; tidak perlu server database)
# Jika DATABASE_URL tidak diisi, aplikasi otomatis memakai SQLite lokal.
# DATABASE_URL=sqlite:///database/manajemen_produk.db

# 2. MySQL
# Buat database terlebih dahulu, misalnya: CREATE DATABASE manajemen_produk;
# Lalu sesuaikan username, password, host, dan nama database.
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/manajemen_produk
